# CrimeNet AI — deployment environment (copy to /etc/crimenet/crimenet.env)
#
# Everything here is read by backend/app/config.py at process start, EXCEPT
# CRIMENET_DIST / CRIMENET_BUILD_ON_BOOT / PORT which belong to the production
# entrypoint backend/serve_prod.py.

# --- environment profile ---------------------------------------------------
# "demo" (default) = hackathon/demonstration profile. Secrets are generated
#                    randomly per process, so every restart invalidates existing
#                    sessions. Fine for a judge demo, wrong for real officers.
# "production"     = REFUSES TO START unless both secrets below are set, and
#                    refuses to start if they are still the published literals.
CRIMENET_ENVIRONMENT=demo

# --- secrets (REQUIRED when CRIMENET_ENVIRONMENT != demo) -------------------
# Generate one per deployment; never reuse the published dev literals:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing CRIMENET_FIELD_KEY after data exists makes previously encrypted
# fields unreadable — back it up before you rotate.
#CRIMENET_JWT_SECRET=
#CRIMENET_FIELD_KEY=

# Session lifetime (minutes). Default 480.
#CRIMENET_JWT_EXPIRY_MINUTES=480

# Set to 1 only if you deliberately want the PUBLISHED demo literals in use
# (they are in the public source, so anyone can forge tokens). Never on an
# internet-facing instance.
#CRIMENET_ALLOW_PUBLIC_DEMO_SECRET=0

# Print the generated per-process secrets to the log (debugging only; off by
# default so secrets never land in logs).
#CRIMENET_LOG_DEMO_SECRETS=0

# Describe how TLS is terminated so /api/health reports it honestly.
CRIMENET_TLS_MODE=TERMINATED_AT_GATEWAY

# --- persistent state (POINT THESE AT THE PERSISTENT DISK) ------------------
# Audit ledger (hash chain) + its witness. Delete these and the audit trail
# starts over — the chain cannot be reconstructed after the fact.
CRIMENET_LEDGER_PATH=/var/lib/crimenet/ledger.db
CRIMENET_LEDGER_WITNESS_PATH=/var/lib/crimenet/ledger_witness.db

# Immutable evidence blobs (write-once objects).
CRIMENET_OBJECT_STORAGE=/var/lib/crimenet/object_storage

# --- where the built SPA lives (serve_prod.py) ------------------------------
CRIMENET_DIST=/opt/crimenet/frontend/dist
# Build the SPA on boot if dist is missing (needs Node on the host). Off for a
# normal deployment: the release step builds it.
CRIMENET_BUILD_ON_BOOT=0

# --- optional real backing services ----------------------------------------
# Leave unset to run the labelled embedded fallbacks (EMBEDDED_RELATIONAL_FALLBACK,
# EMBEDDED_PROPERTY_GRAPH, EMBEDDED_TTL_CACHE) — the app reports which profile is
# active in /api/health, so an embedded run is never mistaken for the real store.
#CRIMENET_POSTGRES_DSN=postgresql://crimenet:password@127.0.0.1:5432/crimenet
#CRIMENET_NEO4J_URI=bolt://127.0.0.1:7687
#CRIMENET_NEO4J_USER=neo4j
#CRIMENET_NEO4J_PASSWORD=
#CRIMENET_REDIS_URL=redis://127.0.0.1:6379/0

# --- login rate limiting (in-process, per officer ID) -----------------------
# 5 failures in 300s locks the ID for 300s with HTTP 429.
#CRIMENET_LOGIN_MAX_ATTEMPTS=5
#CRIMENET_LOGIN_ATTEMPT_WINDOW=300
#CRIMENET_LOGIN_LOCKOUT=300
