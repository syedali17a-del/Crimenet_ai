{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (FastAPI, debuggable)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": false,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Web app (Vite dev server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open CrimeNet AI in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "▶ CrimeNet AI — full stack",
      "configurations": ["API server (FastAPI, debuggable)", "Web app (Vite dev server)"],
      "stopAll": true,
      "presentation": { "group": "crimenet", "order": 1 }
    }
  ]
}
